{
  "name": "ethers-compatibility-test",
  "version": "1.0.0",
  "description": "Test harness for ethers v5/v6 backward compatibility",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:basic": "jest tests/basic.test.js",
    "test:v5": "ETHERS_VERSION=v5 jest",
    "test:v6": "ETHERS_VERSION=v6 jest", 
    "test:compatibility": "npm run test:v5 && npm run test:v6",
    "test:addresses": "node scripts/test-addresses.js",
    "hardhat": "hardhat",
    "fork": "hardhat node --fork https://eth.llamarpc.com",
    "fork:alchemy": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY",
    "start": "npm run fork"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "jest-junit": "^16.0.0"
  },
  "dependencies": {
    "ethers": "^6.8.0",
    "ethers-v5": "npm:ethers@^5.7.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}